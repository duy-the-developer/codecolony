{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "performance": {
        "noBarrelFile": "error"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "CONSTANT_CASE", "snake_case"]
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": ["./lint/module-entries.grit"],
  "overrides": [
    {
      "includes": ["packages/dock/src/server/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/colony/src/modules/world/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/logging/**",
                      "**/theme/**",
                      "**/lane-routing/**",
                      "**/layout/**",
                      "**/wire/**",
                      "**/config/**",
                      "**/language/**",
                      "**/search/**",
                      "**/indexing/**",
                      "**/scene/**",
                      "**/map/**",
                      "**/preferences/**",
                      "**/build-queue/**",
                      "**/server/**",
                      "**/web/**"
                    ],
                    "message": "Imports follow the module rules in CONVENTIONS.md."
                  },
                  {
                    "group": ["**/testing/**"],
                    "message": "testing/ is for tests only."
                  },
                  {
                    "group": ["node:*"],
                    "message": "This code runs in the browser: no Node built-ins."
                  },
                  {
                    "group": ["@codecolony/dock/server"],
                    "message": "Imports follow the module rules in CONVENTIONS.md."
                  },
                  {
                    "group": ["@codecolony/dock/web"],
                    "message": "Imports follow the module rules in CONVENTIONS.md."
