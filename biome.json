                      "**/indexer/**",
                      "**/server/**",
                      "**/web/**",
                      "**/testing/**"
                    ],
                    "message": "Imports follow the folder dependency direction in CONVENTIONS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
